@host = http://localhost:8080

### List agents
GET {{host}}/agents

### Create a workspace
# @name createWorkspace
POST {{host}}/workspaces
Content-Type: application/json

{
  "image": "python:3-slim"
}

### List workspaces
GET {{host}}/workspaces

### Create a coding agent with the first model
# @name createCodingAgent
# @ref models
POST {{host}}/agents
Content-Type: application/json

{
  "name": "coder",
  "model": "{{models[0]}}",
  "prompt": "You are a careful Python developer. Run the tests and fix what fails.",
  "tools": ["read", "write", "bash"]
}

### Create a coding session on the coding agent
# @name createCodingSession
POST {{host}}/sessions
Content-Type: application/json

{
  "agent": "{{createCodingAgent.id}}",
  "workspace": "{{createWorkspace.id}}",
  "prompt": "Write reverse(s) in Python in reverse/reverse.py with a unittest test. Run python -m unittest there, fix any failure."
}

### Stream the coding session events (SSE)
GET {{host}}/sessions/{{createCodingSession.id}}/events

